# Outlook / Google 本机注册控制台环境变量模板
# cp .env.example .env 后填写本机服务、代理与接码凭据；不要提交 .env。

# ---------------- 浏览器 provider ----------------
# ixbrowser（默认）或 donut
BROWSER_PROVIDER=ixbrowser
IXBROWSER_TARGET=127.0.0.1
IXBROWSER_PORT=53200
IXBROWSER_KERNEL_VERSION=

# donut 是备选 provider
DONUT_API_BASE=http://127.0.0.1:10108
# 留空时从 DonutBrowserDev 本地设置自动读取 token
DONUT_API_TOKEN=
DONUT_PROFILE_REUSE=true

# ---------------- 代理 / Outlook ----------------
# Outlook 自注册住宅代理池；多个用逗号或换行分隔，可留空
OUTLOOK_PROXIES=
OUTLOOK_CARD=
# standalone Outlook loop 需要时使用 Clash 控制面
CLASH_API=http://127.0.0.1:9097
CLASH_SECRET=
CLASH_PROXY=http://127.0.0.1:7897
CLASH_GROUP=GLOBAL

# Outlook 注册验证码（可选）
CAPSOLVER_API_KEY=
EZCAPTCHA_API_KEY=
EZCAPTCHA_API_BASE=https://api.ez-captcha.com

# ---------------- Google 接码 ----------------
SMS_API_BASE=http://www.firefox.fun/yhapi.ashx
SMS_TOKEN=
HERO_SMS_API_BASE=https://hero-sms.com/stubs/handler_api.php
HERO_SMS_API_KEY=
# Google 网页/Donut hybrid 注册对应的接码服务参数
SMS_PROJECT_ID_GMAIL=
HERO_SMS_SERVICE_GMAIL=go
SMS_MAXPRICE_GMAIL=0
SMS_COUNTRY_BLACKLIST_GMAIL=
SMS_HERO_COUNTRIES=52,6,4,10,73,22,54,19,60,7
SMS_HERO_OPERATOR=
SMS_HERO_FIXED_PRICE=true
SMS_MAX_TRIES=10
SMS_CODE_WAIT=90
# 默认是单体 API；如单独部署 SMS service 再覆盖
SMS_SERVICE_URL=http://127.0.0.1:8000

# ---------------- Gmail Android/Appium ----------------
APPIUM_SERVER=http://127.0.0.1:4723
ANDROID_DEVICE=127.0.0.1:5675
ADB_PATH=
GMAIL_USERNAME_PREFIX=
PHONE_VERIFICATION_MODE=manual
# 仅在操作者明确同意 Google Privacy and Terms 后启用
ACCEPT_TERMS=0
