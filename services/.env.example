# 本机单体：无需 Docker、Redis、Celery 或 PostgreSQL。
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///data/regfactory.db
JWT_SECRET_KEY=dev-secret-change-me
# 开发/测试允许自动建表；正式本机发行应先执行 alembic upgrade head。
AUTO_CREATE_SCHEMA=true
SEED_ADMIN_USER=
SEED_ADMIN_PASSWORD=
# 单进程 WebSocket Hub 与 SQLite 写入策略要求 Uvicorn --workers 1。
TASK_MAX_CONCURRENCY=1
TASK_STALE_AFTER_SECONDS=30
# 相对于项目根目录的前端构建产物位置。
STATIC_DIR=frontend/dist
CORS_ORIGINS=["http://localhost:3000"]
